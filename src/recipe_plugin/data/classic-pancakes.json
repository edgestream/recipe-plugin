  "recipeIngredient": [
    "250 g all-purpose flour",
    "2 tablespoons sugar",
    "2 teaspoons baking powder",
    "1 pinch salt",
    "2 eggs",
    "300 ml milk",
    "30 g melted butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Whisk flour, sugar, baking powder, and salt in a large bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk in eggs, milk, and melted butter until just combined."
    },
    {
      "@type": "HowToStep",
      "text": "Cook ladles of batter in a lightly buttered skillet until golden on both sides."
    }
  ]
}
